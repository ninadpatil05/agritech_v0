FLASK_APP=app.py
FLASK_DEBUG=false
SECRET_KEY=generate-with-python-secrets-module

GEMINI_API_KEY=your_google_gemini_api_key_here
OPENWEATHER_KEY=your_openweathermap_api_key_here

JWT_SECRET=generate-with-python-secrets-module
JWT_EXPIRES_HOURS=72

DB_PATH=agritech.db
MODEL_PATH=models/
BLUR_THRESHOLD=80.0

CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=your_email@gmail.com
CONTACT_SMTP_PASSWORD=your_app_password_here
CONTACT_MAIL_TO=your_email@gmail.com
